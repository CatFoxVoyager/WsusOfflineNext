<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <AssemblyName>UpdateGenerator</AssemblyName>
    <RootNamespace>WSUSOffline.Generator</RootNamespace>
    <Product>WSUS Offline Next</Product>
    <Description>WSUS Offline Next - Generator</Description>
    <Version>5.1.1+2026.11</Version>
    <FileVersion>5.1.1.0</FileVersion>
    <AssemblyVersion>5.1.1.0</AssemblyVersion>
    <ApplicationIcon>..\..\..\ico\wson.ico</ApplicationIcon>
    
    <!-- Single File Output Settings -->
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>false</SelfContained>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4314.35" />
  </ItemGroup>

  <!-- Embed React assets directly inside the EXE assembly resources -->
  <ItemGroup>
    <EmbeddedResource Include="..\dist\**" LogicalName="wwwroot.%(RecursiveDir)%(Filename)%(Extension)" />
    <None Include="..\dist\**" Link="wwwroot\%(RecursiveDir)%(Filename)%(Extension)">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </None>
  </ItemGroup>

</Project>
