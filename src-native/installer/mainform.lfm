object MainForm: TMainForm
  Left = 60
  Height = 360
  Top = 60
  Width = 560
  Caption = 'WSUS Offline Next - Installer'
  ClientHeight = 331
  ClientWidth = 546
  OnCreate = FormCreate
  LCLVersion = '4.8.0.0'
  object lblIntro: TLabel
    Left = 16
    Height = 30
    Top = 10
    Width = 514
    AutoSize = False
    Caption = 'Select desired options and click Start to install missing Microsoft updates on your computer.'
    WordWrap = True
  end
  object chkUpdateCpp: TCheckBox
    Left = 16
    Height = 23
    Top = 48
    Width = 320
    Caption = 'Update C++ Runtime Libraries'
    TabOrder = 0
  end
  object chkVerify: TCheckBox
    Left = 16
    Height = 23
    Top = 76
    Width = 320
    Caption = 'Verify installation packages'
    TabOrder = 1
  end
  object chkAuditOnly: TCheckBox
    Left = 16
    Height = 23
    Top = 104
    Width = 380
    Caption = 'Audit only (missing updates report)'
    TabOrder = 2
  end
  object memoProgress: TMemo
    Left = 16
    Height = 150
    Top = 136
    Width = 514
    ReadOnly = True
    ScrollBars = ssVertical
    TabOrder = 3
  end
  object btnStart: TButton
    Left = 16
    Height = 30
    Top = 292
    Width = 100
    Caption = 'Start'
    Default = True
    TabOrder = 4
    OnClick = btnStartClick
  end
  object btnExit: TButton
    Left = 430
    Height = 30
    Top = 292
    Width = 100
    Cancel = True
    Caption = 'Exit'
    TabOrder = 5
    OnClick = btnExitClick
  end
end
